# Prompt Anatomy CMO Kit — fulfillment env (promptanatomy.space)
# -------------------------------------------------------------------
# 1. Local webhook testing: copy .env.example .env (Windows) / cp on macOS/Linux
# 2. Production: paste each line into Vercel -> promptanatomy.space project
#    -> Settings -> Environment Variables -> Production (never commit .env)
# 3. Webhook URL must be: https://promptanatomy.space/api/stripe-webhook
#    (single host: success URL, webhook, SITE_URL, Redis must all be .space)
# 4. Mirror (ditreneris.github.io/cmo) cannot run /api/*; checkout always
#    redirects buyer to .space via absolute Stripe Payment Links.
# -------------------------------------------------------------------

# --- Stripe (live keys for live Payment Links) ---
# Dashboard -> Developers -> API keys -> Secret key
STRIPE_SECRET_KEY=sk_live_REPLACE_ME

# Dashboard -> Developers -> Webhooks -> endpoint promptanatomy.space -> Signing secret
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME

# Payment Link -> open product/price -> Price ID (price_...)
STRIPE_PRICE_CMO_STARTER_PDF=price_REPLACE_STARTER
STRIPE_PRICE_CMO_PRO_PDF=price_REPLACE_PRO
STRIPE_PRICE_CMO_BUNDLE_PDF=price_REPLACE_BUNDLE

# --- Upstash Redis (fulfillment state + download tokens) ---
# console.upstash.com -> your database -> REST API -> URL + Token
UPSTASH_REDIS_REST_URL=https://REPLACE.upstash.io
UPSTASH_REDIS_REST_TOKEN=REPLACE_ME

# --- Signed download links ---
# Generate: openssl rand -base64 48 (or any long random string, 32+ chars)
# If the value contains "+" or "/", quote it in Vercel UI to avoid space corruption.
DOWNLOAD_TOKEN_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET

# --- Email (Resend) ---
# resend.com -> API Keys
RESEND_API_KEY=re_REPLACE_ME

# resend.com -> Domains -> verified sender (must match a domain you own and verified in Resend)
FULFILLMENT_FROM_EMAIL=Prompt Anatomy <orders@yourdomain.example>

# --- Vercel Blob (recommended for PDF storage) ---
# Vercel -> Storage -> Create Blob store -> Connect to promptanatomy.space project
# Token is auto-added as BLOB_READ_WRITE_TOKEN. Upload PDFs:
#   npm run pdf:export && npm run pdf:upload-blob
BLOB_READ_WRITE_TOKEN=vercel_blob_REPLACE_ME

# --- PDF sources (private Blob URLs from upload script) ---
PDF_CMO_STARTER_SOURCE_URL=https://REPLACE.private.blob.vercel-storage.com/paid-pdfs/cmo-starter.pdf
PDF_CMO_PRO_SOURCE_URL=https://REPLACE.private.blob.vercel-storage.com/paid-pdfs/cmo-pro.pdf
PDF_CMO_PRO_MD_SOURCE_URL=https://REPLACE.private.blob.vercel-storage.com/paid-pdfs/cmo-pro-prompts.md

# --- Optional follow-up emails (Starter buyers only, transactional) ---
# FULFILLMENT_FOLLOWUP_ENABLED=1
# CRON_SECRET=generate_a_long_random_string_for_vercel_cron_auth

# Optional: Payment Link ids (plink_...) when the Stripe account also sells other products.
# Unknown checkouts are ignored (HTTP 200). Do not match on dollar amount.
# STRIPE_PAYMENT_LINK_CMO_STARTER=plink_REPLACE_STARTER
# STRIPE_PAYMENT_LINK_CMO_PRO=plink_REPLACE_PRO
# STRIPE_PAYMENT_LINK_CMO_BUNDLE=plink_REPLACE_BUNDLE

# Optional: if PDF host requires auth headers besides Blob token
# PDF_SOURCE_AUTH_TOKEN=
# PDF_SOURCE_AUTH_HEADER=Authorization: Bearer YOUR_TOKEN

# --- Recommended ---
SITE_URL=https://promptanatomy.space

# --- Optional (defaults applied in code if omitted) ---
# DOWNLOAD_TOKEN_TTL_SECONDS=604800           # 7 days (email link)
# IN_PAGE_DOWNLOAD_TOKEN_TTL_SECONDS=900      # 15 minutes (success page)
# FULFILLMENT_STATE_TTL_SECONDS=7776000       # 90 days (Redis state retention)
